# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here

# Supabase dashboard > Project Settings > API > anon public key
# Safe in the browser only because Row Level Security is enabled on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: only this email may use the app, even if another account exists.
ALLOWED_EMAIL=you@example.com

# Optional: days without contact before a person is highlighted (default 60).
NEXT_PUBLIC_STALE_DAYS=60
